            "isNew": true,
            "commencementDate": "2026-10-01",
            "status": "upcoming",
            "note": "Any NDA preventing disclosure of harassment/discrimination is void from October 2026."
          }
        },
        {
          "id": "narrative",
          "label": "Full Account",
          "type": "textarea",
          "required": false
        }
      ]
