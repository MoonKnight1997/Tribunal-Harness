# coffeecup — environment variables
# Copy to .env.local for development. Never commit real values.

# ── Brand (public; no secrets) ────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=coffeecup
NEXT_PUBLIC_BRAND_STRAPLINE=Help with a problem at work, one step at a time.
NEXT_PUBLIC_BRAND_OPERATOR=the coffeecup project
NEXT_PUBLIC_BRAND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=support@example.invalid
NEXT_PUBLIC_BRAND_PRIVACY_EMAIL=privacy@example.invalid

# ── Database ──────────────────────────────────────────────────────────────
# Production: a PostgreSQL connection string. Leave unset in development to
# use the embedded PGlite database persisted under ./data/pglite.
# DATABASE_URL=postgres://user:pass@host:5432/coffeecup
# AUTO_MIGRATE=1            # apply ./drizzle migrations on first connection (default on)
# PGLITE_DATA_DIR=./data/pglite

# ── Model provider (see docs/AI_PROVIDER_ARCHITECTURE.md) ─────────────────
# mock (default when no key is set) | anthropic | openai_compatible
LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# Tier overrides (cheap = extraction/classification, mid = structuring/drafting, high = analysis/critique)
# LLM_MODEL_CHEAP=
# LLM_MODEL_MID=
# LLM_MODEL_HIGH=
# LLM_TIMEOUT_MS=120000
# ALLOW_MOCK_LLM_IN_PRODUCTION=0

# ── Regulatory feature flags (server-side; default off) ───────────────────
ENABLE_PERSONALISED_CLAIM_IDENTIFICATION=false
ENABLE_PERSONALISED_ET1_DRAFTING=false
ENABLE_CASELAW_LLM_ANALYSIS=false
ENABLE_EXTERNAL_CASE_REFERRAL=false
ENABLE_PAID_CLAIM_FEATURES=false

# ── Payments ──────────────────────────────────────────────────────────────
PAYMENTS_ENABLED=0            # 0 = everything free (pricing experiment off)
# PAYMENT_PROVIDER=stripe     # stripe | mock
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PRICE_CASE_PASS_PENCE=699
# PRICE_CLAIM_PACK_PENCE=999

# ── Fair use (per case per day) ───────────────────────────────────────────
# FAIR_USE_DOCUMENT_EXTRACTION_PER_DAY=40
# FAIR_USE_AI_GENERATION_PER_DAY=60
# FAIR_USE_CLAIM_ANALYSIS_PER_DAY=10

# ── Background jobs ───────────────────────────────────────────────────────
# JOBS_INLINE=1               # run jobs right after enqueue (default in dev/test)
# JOBS_RUN_TOKEN=             # bearer token for POST /api/jobs/run (production scheduler)
# DELETED_CASE_RETENTION_DAYS=30

# ── Storage ───────────────────────────────────────────────────────────────
# STORAGE_PROVIDER=database   # database (default) | local_disk
# UPLOADS_DIR=./data/uploads

# ── Email (account recovery) ──────────────────────────────────────────────
# EMAIL_API_KEY=              # Resend-compatible; unset = log to console in dev
# EMAIL_API_URL=https://api.resend.com/emails
# EMAIL_FROM="coffeecup <no-reply@example.invalid>"

# ── Analytics ─────────────────────────────────────────────────────────────
# ANALYTICS_SALT=change-me
# ANALYTICS_DISABLED=0

# ── Legal configuration ───────────────────────────────────────────────────
# Override the assumed ERA 2025 six-month time-limit commencement once the SI is confirmed (YYYY-MM-DD).
# ERA_2025_TIME_LIMIT_COMMENCEMENT=2026-10-01
